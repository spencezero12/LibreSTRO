
/* LibreSTRO - Tema claro */

QMainWindow {
    background-color: #eef1f5;
}

QLabel {
    color: #253041;
    font-size: 14px;
}

QLabel#titulo {
    font-size: 24px;
    font-weight: bold;
    padding: 10px;
}

QLabel#encabezado {
    font-size: 18px;
    font-weight: bold;
}

QFrame#barraLateral,
QFrame#biblioteca,
QFrame#reproductor {
    background-color: #ffffff;
    border-radius: 8px;
}

QPushButton {
    background-color: #dfe6ef;
    color: #253041;
    border: none;
    border-radius: 6px;
    padding: 10px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #c5d8ed;
}

QPushButton:focus {
    border: 2px solid #426c9c;
}
